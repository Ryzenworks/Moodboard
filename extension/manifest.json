{
  "manifest_version": 3,
  "name": "Moodboard Saver",
  "version": "2.4",
  "description": "Right-click any image to save it to your Moodboard. Works on Instagram, Pinterest, YouTube, and more.",
  "permissions": ["contextMenus", "scripting", "storage", "tabs", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-detect.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}